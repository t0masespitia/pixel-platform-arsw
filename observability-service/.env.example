# Copiar como .env en este mismo directorio. No se sube a git.
# Requerido para levantar observability-service/docker-compose.yml.

# Usuario del panel Grafana (por defecto: admin)
GRAFANA_USER=admin

# Contraseña del panel Grafana. Generar con: openssl rand -hex 12
GRAFANA_PASSWORD=<reemplazar-con-salida-de-openssl-rand-hex-12>
