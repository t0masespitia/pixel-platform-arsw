# Copia este archivo a application-dev-local.properties (sin .example)
# y completa con tus credenciales reales. Ese archivo NO se sube a git.

# Credenciales de base de datos (desarrollo local)
# Deben coincidir con DB_USER / DB_PASSWORD del postgres local.
spring.datasource.username=pixel_user
spring.datasource.password=<contrasena-local-de-desarrollo>
