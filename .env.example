# Copiar este archivo como .env y completar los valores reales.
# .env está en .gitignore y nunca debe subirse al repositorio.

# ── Base de datos ──────────────────────────────────────────────────────────────
# Usuario del cluster PostgreSQL. Cambiar el usuario requiere recrear el volumen
# o usar ALTER USER dentro del contenedor (ver ROTATION.md).
DB_USER=pixel_user

# Contraseña de la base de datos. Generar con:
#   openssl rand -hex 16
# ADVERTENCIA: cambiar esta variable NO rota la contraseña de un volumen ya
# existente. Ver procedimiento de rotación en ROTATION.md.
DB_PASSWORD=<reemplazar-con-salida-de-openssl-rand-hex-16>

# ── Redis ──────────────────────────────────────────────────────────────────────
# Contraseña de Redis. Generar con:
#   openssl rand -hex 16
REDIS_PASSWORD=<reemplazar-con-salida-de-openssl-rand-hex-16>

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
# Mínimo 32 bytes (256 bits). El servicio falla al arrancar si está vacío.
JWT_SECRET=<reemplazar-con-salida-de-openssl-rand-hex-32>

# ── Servidor ───────────────────────────────────────────────────────────────────
# Dominio o IP pública del servidor (sin barra final)
PUBLIC_ORIGIN=http://tu-dominio-o-ip

# ── Correo ─────────────────────────────────────────────────────────────────────
MAIL_USERNAME=tu-correo@gmail.com
MAIL_APP_PASSWORD=tu-app-password-de-gmail

# ── Observabilidad (observability-service/docker-compose.yml) ──────────────────
# Contraseña del panel Grafana. Generar con: openssl rand -hex 12
GRAFANA_PASSWORD=<reemplazar-con-salida-de-openssl-rand-hex-12>
